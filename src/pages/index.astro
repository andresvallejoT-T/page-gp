---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const entradas = (await getCollection('secciones')).sort(
  (a, b) => a.data.orden - b.data.orden
);
const secciones = await Promise.all(
  entradas.map(async (e) => ({
    id: e.id,
    titulo: e.data.titulo,
    Content: (await render(e)).Content,
  }))
);
---
<Base titulo="Prácticum en el KBS">
  <div id="progreso" aria-hidden="true"></div>
  <header class="top">
    <div class="wrap top-in">
      <a href={`${base}/`} class="marca">
        <img src={`${base}/logo.png`} alt="Logo del grupo KBS" width="56" height="56" />
        <span>KBS</span>
      </a>
      <nav aria-label="Secciones">
        {secciones.map((s) => <a href={`#${s.id}`} data-id={s.id}>{s.titulo}</a>)}
      </nav>
    </div>
  </header>

  <section class="hero">
    <div class="wrap">
      <img src={`${base}/logo.png`} alt="" width="220" height="220" class="hero-logo" />
      <h1>Prácticum en el grupo KBS</h1>
      <p>
        Información para estudiantes que realizarán sus prácticas preprofesionales
        en el grupo de investigación Sistemas Basados en el Conocimiento.
      </p>
    </div>
    <div class="franja" aria-hidden="true">
      <i style="background:var(--azul)"></i>
      <i style="background:var(--celeste)"></i>
      <i style="background:var(--verde)"></i>
      <i style="background:var(--amarillo)"></i>
    </div>
  </section>

  <main class="wrap">
    {secciones.map((s) => (
      <section id={s.id}>
        <h2>{s.titulo}</h2>
        <s.Content />
      </section>
    ))}
  </main>

  <button id="arriba" type="button" aria-label="Volver arriba" title="Volver arriba">↑</button>

  <footer>
    <div class="wrap">Grupo de Investigación KBS · Sistemas Basados en el Conocimiento</div>
  </footer>
</Base>

<script>
  // --- Barra de progreso, enlace activo y botón "volver arriba" ---
  const barra = document.getElementById('progreso');
  const arriba = document.getElementById('arriba');
  const enlaces = [...document.querySelectorAll('nav a[data-id]')];

  function alScroll() {
    const alto = document.documentElement.scrollHeight - window.innerHeight;
    const pct = alto > 0 ? (window.scrollY / alto) * 100 : 0;
    if (barra) barra.style.width = pct + '%';
    arriba?.classList.toggle('visible', window.scrollY > 600);
  }
  window.addEventListener('scroll', alScroll, { passive: true });
  alScroll();

  arriba?.addEventListener('click', () => window.scrollTo({ top: 0 }));

  const secs = [...document.querySelectorAll('main > section[id]')];
  const spy = new IntersectionObserver(
    (entradas) => {
      entradas.forEach((e) => {
        if (!e.isIntersecting) return;
        enlaces.forEach((a) => {
          const activo = a.dataset.id === e.target.id;
          a.classList.toggle('activo', activo);
          if (activo) a.setAttribute('aria-current', 'true');
          else a.removeAttribute('aria-current');
        });
      });
    },
    { rootMargin: '-25% 0px -65% 0px' }
  );
  secs.forEach((s) => spy.observe(s));

  // --- Aparición suave de las secciones ---
  const reducir = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reducir && 'IntersectionObserver' in window) {
    const reveal = new IntersectionObserver(
      (entradas, obs) => {
        entradas.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('visto');
            obs.unobserve(e.target);
          }
        });
      },
      { threshold: 0.08 }
    );
    secs.forEach((s) => {
      s.classList.add('reveal');
      reveal.observe(s);
    });
  }

  // --- Proyectos: cada <h3> de una sección pasa a ser una tarjeta desplegable ---
  document.querySelectorAll('main > section').forEach((sec) => {
    const titulos = [...sec.querySelectorAll(':scope > h3')];
    if (titulos.length === 0) return;

    const tarjetas = [];
    titulos.forEach((h3, i) => {
      const det = document.createElement('details');
      det.className = 'tarjeta';
      if (i === 0) det.open = true;

      const sum = document.createElement('summary');
      sum.textContent = h3.textContent;

      const cuerpo = document.createElement('div');
      cuerpo.className = 'tarjeta-cuerpo';

      let sig = h3.nextElementSibling;
      while (sig && sig.tagName !== 'H3') {
        const siguiente = sig.nextElementSibling;
        if (sig.tagName === 'HR') sig.remove();
        else cuerpo.appendChild(sig);
        sig = siguiente;
      }

      det.append(sum, cuerpo);
      h3.replaceWith(det);
      tarjetas.push(det);
    });

    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'toggle-todo';
    btn.textContent = 'Expandir todo';
    btn.addEventListener('click', () => {
      const abrir = tarjetas.some((t) => !t.open);
      tarjetas.forEach((t) => (t.open = abrir));
      btn.textContent = abrir ? 'Contraer todo' : 'Expandir todo';
    });
    tarjetas[0].before(btn);
  });
</script>

<style is:global>
  #progreso { position: fixed; top: 0; left: 0; height: 3px; width: 0; background: var(--celeste); z-index: 20; }

  nav a.activo { color: var(--azul); font-weight: 600; border-bottom-color: var(--azul); }

  /* Aparición suave (solo si hay JavaScript y no se pidió reducir movimiento) */
  @media (prefers-reduced-motion: no-preference) {
    .js .reveal { opacity: 0; transform: translateY(14px); transition: opacity .5s ease, transform .5s ease; }
    .js .reveal.visto { opacity: 1; transform: none; }
  }

  /* Tarjetas desplegables y preguntas frecuentes */
  .tarjeta, main details { background: white; border: 1px solid #dde3ea; border-radius: 10px; margin: .6rem 0; overflow: hidden; }
  .tarjeta[open], main details[open] { border-color: var(--celeste); box-shadow: 0 2px 10px rgba(0, 78, 127, .08); }
  .tarjeta > summary, main details > summary {
    cursor: pointer; list-style: none; padding: .8rem 1rem; font-weight: 700; color: var(--azul);
    display: flex; justify-content: space-between; align-items: center; gap: 1rem;
  }
  .tarjeta > summary::-webkit-details-marker, main details > summary::-webkit-details-marker { display: none; }
  .tarjeta > summary::after, main details > summary::after { content: "+"; font-size: 1.4rem; line-height: 1; color: var(--celeste); transition: transform .2s; }
  .tarjeta[open] > summary::after, main details[open] > summary::after { content: "−"; }
  .tarjeta > summary:hover, main details > summary:hover { background: #f1f7fc; }
  .tarjeta > summary:focus-visible, main details > summary:focus-visible { outline: 3px solid var(--celeste); outline-offset: -3px; }
  .tarjeta-cuerpo, main details > :not(summary) { padding: 0 1rem; }
  .tarjeta-cuerpo { padding-bottom: .6rem; }
  main details > :last-child { padding-bottom: .8rem; }

  .toggle-todo {
    font: inherit; font-size: .9rem; cursor: pointer; background: white; color: var(--azul);
    border: 1px solid var(--azul); border-radius: 999px; padding: .25rem .9rem; margin: .5rem 0 .2rem;
  }
  .toggle-todo:hover { background: var(--azul); color: white; }

  /* Botón volver arriba */
  #arriba {
    position: fixed; right: 1.2rem; bottom: 1.2rem; width: 44px; height: 44px; border-radius: 50%;
    border: none; background: var(--azul); color: white; font-size: 1.3rem; cursor: pointer;
    box-shadow: 0 2px 8px rgba(0, 0, 0, .25); opacity: 0; pointer-events: none; transition: opacity .25s; z-index: 10;
  }
  #arriba.visible { opacity: 1; pointer-events: auto; }
  #arriba:hover { background: var(--celeste); }
  #arriba:focus-visible { outline: 3px solid var(--amarillo); outline-offset: 2px; }
</style>

<style>
  .top { background: white; border-bottom: 1px solid #e3e8ee; position: sticky; top: 0; z-index: 5; }
  .top-in { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-top: .5rem; padding-bottom: .5rem; }
  .marca { display: flex; align-items: center; gap: .6rem; text-decoration: none; font-weight: 800; font-size: 1.4rem; color: var(--azul); }
  .marca img { height: 44px; width: 44px; object-fit: contain; }
  nav { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: flex-end; font-size: .92rem; }
  nav a { text-decoration: none; color: var(--texto); padding: .2rem 0; border-bottom: 2px solid transparent; }
  nav a:hover { border-bottom-color: var(--celeste); }

  .hero { text-align: center; padding: 3rem 0 0; }
  .hero-logo { max-width: 60%; height: auto; }
  h1 { color: var(--azul); font-size: clamp(1.8rem, 5vw, 2.6rem); line-height: 1.15; margin: .5rem 0; }
  .hero p { max-width: 36rem; margin: 0 auto 2.5rem; font-size: 1.1rem; }
  .franja { display: flex; height: 6px; }
  .franja i { flex: 1; }

  main { padding-top: 1rem; padding-bottom: 3rem; }
  section { padding-top: 2.5rem; scroll-margin-top: 4.5rem; }
  h2 { color: var(--azul); font-size: 1.5rem; margin: 0 0 .75rem; }
  main :global(ul), main :global(ol) { padding-left: 1.3rem; }
  main :global(li) { margin: .25rem 0; }
  main :global(table) { border-collapse: collapse; width: 100%; font-size: .95rem; }
  main :global(th), main :global(td) { text-align: left; padding: .5rem .6rem; border-bottom: 1px solid #dde3ea; }
  main :global(th) { color: var(--azul); }

  footer { background: var(--azul); color: white; padding: 1.5rem 0; font-size: .9rem; text-align: center; }

  @media (max-width: 40rem) {
    .top-in { flex-direction: column; align-items: flex-start; }
    nav { justify-content: flex-start; }
  }
</style>
